[Unit]
Description=VOD archive live chat logger
After=network-online.target
Wants=network-online.target

[Service]
User=vodarchive
WorkingDirectory=/opt/vod-archive
ExecStart=/opt/vod-archive/.venv/bin/python pipeline/chat_logger.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
